<div class="auth-page">
  <section class="auth-left"><div class="auth-brand"><div style="font-size:38px">🎬</div><h1>Binge Diary</h1><p>Your personal movie diary.</p></div><div class="movie-illustration">🍿</div></section>
  <section class="auth-card">
    <h1>Welcome Back!</h1><p class="auth-subtitle">Login to continue</p>
    <div class="error-message" id="form-error" hidden></div>
    <form id="login-form">
      <label for="email">Email</label><input id="email" name="email" type="email" placeholder="Enter your email" autocomplete="email" required>
      <label for="password">Password</label><input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" required>
      <button class="primary-button full" type="submit">Login</button>
    </form>
    <p class="auth-footer">Don't have an account? <a href="/register">Sign up</a></p>
  </section>
</div>